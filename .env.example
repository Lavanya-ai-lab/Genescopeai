# Copy to .env and fill locally. Never commit real credentials.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_LLM_MODEL=
NEBIUS_EMBEDDING_MODEL=

# Optional LangSmith tracing; false disables hosted trace uploads.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=genescope-week5
# For agent-based workspaces use the agent/environment from LangSmith setup.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=
LANGSMITH_WORKSPACE_ID=
# Set your region's endpoint if different from the US default.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional independent offline judge. Blank values use the Nebius settings.
# Use a different judge model when available; same-model bias is disclosed.
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_BASE_URL=
